# AI_INTEGRATIONS_OPENAI_API_KEY: Replit LLM Gateway API key.
# Store this in the Replit Secrets panel; never commit it to this file.
AI_INTEGRATIONS_OPENAI_API_KEY="MY_LLM_GATEWAY_API_KEY"

# Optional: override the default Replit Gateway base URL.
AI_INTEGRATIONS_OPENAI_BASE_URL="https://integrations.replit.com/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
